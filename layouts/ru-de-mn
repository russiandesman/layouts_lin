// Russian Mnemonic over German keyboard layout (QWERTZ)
//
// All letter keys produce Cyrillic (phonetically mapped to QWERTZ positions).
// Right Alt (AltGr) provides: currency signs, punctuation, brackets.
// Note: Y and Z are swapped vs QWERTY — AD06=з, AB01=ы.
//
// Installation:
//   sudo cp ru-de-mn /usr/share/X11/xkb/symbols/

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "level3(ralt_switch)"

    name[Group1] = "Russian (Mnemonic, DE)";

    key <TLDE> { [ Cyrillic_hardsign, Cyrillic_HARDSIGN, asciicircum,  degree             ] }; // ъ Ъ ^ °
    key <AE01> { [ 1,                 exclam,            1,            exclam             ] }; // 1 ! 1 !
    key <AE02> { [ 2,                 quotedbl,          twosuperior,  quotedbl           ] }; // 2 " ² "
    key <AE03> { [ 3,                 section,           threesuperior, section           ] }; // 3 § ³ §
    key <AE04> { [ 4,                 dollar,            4,            dollar             ] }; // 4 $ 4 $
    key <AE05> { [ 5,                 percent,           5,            percent            ] }; // 5 % 5 %
    key <AE06> { [ 6,                 ampersand,         6,            ampersand          ] }; // 6 & 6 &
    key <AE07> { [ 7,                 slash,             braceleft,    slash              ] }; // 7 / { /
    key <AE08> { [ 8,                 parenleft,         bracketleft,  parenleft          ] }; // 8 ( [ (
    key <AE09> { [ 9,                 parenright,        bracketright, parenright         ] }; // 9 ) ] )
    key <AE10> { [ 0,                 equal,             braceright,   equal              ] }; // 0 = } =
    key <AE11> { [ asciitilde,        question,          backslash,    question           ] }; // ~ ? \ ?
    key <AE12> { [ apostrophe,        grave,             acute,        grave              ] }; // ' ` ´ `

    key <AD01> { [ Cyrillic_ya,       Cyrillic_YA,       at,           Cyrillic_YA        ] }; // я Я @ Я
    key <AD02> { [ Cyrillic_sha,      Cyrillic_SHA,      Cyrillic_sha, Cyrillic_SHA       ] }; // ш Ш ш Ш
    key <AD03> { [ Cyrillic_ie,       Cyrillic_IE,       EuroSign,     Cyrillic_IE        ] }; // е Е € Е
    key <AD04> { [ Cyrillic_er,       Cyrillic_ER,       U20BD,        Cyrillic_ER        ] }; // р Р ₽ Р
    key <AD05> { [ Cyrillic_te,       Cyrillic_TE,       Cyrillic_te,  Cyrillic_TE        ] }; // т Т т Т
    key <AD06> { [ Cyrillic_ze,       Cyrillic_ZE,       Cyrillic_ze,  Cyrillic_ZE        ] }; // з З з З  (Z key on DE)
    key <AD07> { [ Cyrillic_u,        Cyrillic_U,        Cyrillic_u,   Cyrillic_U         ] }; // у У у У
    key <AD08> { [ Cyrillic_i,        Cyrillic_I,        Cyrillic_i,   Cyrillic_I         ] }; // и И и И
    key <AD09> { [ Cyrillic_o,        Cyrillic_O,        Cyrillic_o,   Cyrillic_O         ] }; // о О о О
    key <AD10> { [ Cyrillic_pe,       Cyrillic_PE,       sterling,     Cyrillic_PE        ] }; // п П £ П
    key <AD11> { [ Cyrillic_yu,       Cyrillic_YU,       Cyrillic_yu,  Cyrillic_YU        ] }; // ю Ю ю Ю  (Ü key on DE)
    key <AD12> { [ Cyrillic_zhe,      Cyrillic_ZHE,      plus,         asterisk           ] }; // ж Ж + *  (+ key on DE)

    key <AC01> { [ Cyrillic_a,        Cyrillic_A,        Cyrillic_a,   Cyrillic_A         ] }; // а А а А
    key <AC02> { [ Cyrillic_es,       Cyrillic_ES,       dollar,       Cyrillic_ES        ] }; // с С $ С
    key <AC03> { [ Cyrillic_de,       Cyrillic_DE,       Cyrillic_de,  Cyrillic_DE        ] }; // д Д д Д
    key <AC04> { [ Cyrillic_ef,       Cyrillic_EF,       sterling,     Cyrillic_EF        ] }; // ф Ф £ Ф
    key <AC05> { [ Cyrillic_ghe,      Cyrillic_GHE,      Cyrillic_ghe, Cyrillic_GHE       ] }; // г Г г Г
    key <AC06> { [ Cyrillic_che,      Cyrillic_CHE,      Cyrillic_che, Cyrillic_CHE       ] }; // ч Ч ч Ч
    key <AC07> { [ Cyrillic_shorti,   Cyrillic_SHORTI,   Cyrillic_shorti, Cyrillic_SHORTI ] }; // й Й й Й
    key <AC08> { [ Cyrillic_ka,       Cyrillic_KA,       Cyrillic_ka,  Cyrillic_KA        ] }; // к К к К
    key <AC09> { [ Cyrillic_el,       Cyrillic_EL,       Cyrillic_el,  Cyrillic_EL        ] }; // л Л л Л
    key <AC10> { [ Cyrillic_io,       Cyrillic_IO,       Cyrillic_io,  Cyrillic_IO        ] }; // ё Ё ё Ё  (Ö key on DE)
    key <AC11> { [ Cyrillic_e,        Cyrillic_E,        Cyrillic_e,   Cyrillic_E         ] }; // э Э э Э  (Ä key on DE)

    key <BKSL> { [ Cyrillic_shcha,    Cyrillic_SHCHA,    numbersign,   apostrophe         ] }; // щ Щ # '  (# key on DE)

    key <AB01> { [ Cyrillic_yeru,     Cyrillic_YERU,     yen,          Cyrillic_YERU      ] }; // ы Ы ¥ Ы  (Y key on DE)
    key <AB02> { [ Cyrillic_ha,       Cyrillic_HA,       Cyrillic_ha,  Cyrillic_HA        ] }; // х Х х Х
    key <AB03> { [ Cyrillic_tse,      Cyrillic_TSE,      Cyrillic_tse, Cyrillic_TSE       ] }; // ц Ц ц Ц
    key <AB04> { [ Cyrillic_ve,       Cyrillic_VE,       Cyrillic_ve,  Cyrillic_VE        ] }; // в В в В
    key <AB05> { [ Cyrillic_be,       Cyrillic_BE,       Cyrillic_be,  Cyrillic_BE        ] }; // б Б б Б
    key <AB06> { [ Cyrillic_en,       Cyrillic_EN,       Cyrillic_en,  Cyrillic_EN        ] }; // н Н н Н
    key <AB07> { [ Cyrillic_em,       Cyrillic_EM,       mu,           Cyrillic_EM        ] }; // м М µ М
    key <AB08> { [ comma,             semicolon,         comma,        semicolon          ] }; // , ; , ;
    key <AB09> { [ period,            colon,             period,       colon              ] }; // . : . :
    key <AB10> { [ Cyrillic_softsign, Cyrillic_SOFTSIGN, minus,        underscore         ] }; // ь Ь - _  (- key on DE)

    key <LSGT> { [ less,              greater,           bar,          greater            ] }; // < > | >  (extra ISO key)
};
