// Russian Mnemonic over US keyboard layout
//
// All letter keys produce Cyrillic (phonetically mapped to QWERTY positions).
// Right Alt restores US punctuation on overridden keys (- = [ ] ` \)
// and gives ё/Ё on E.
//
// Installation:
//   sudo cp ru-us-mn /usr/share/X11/xkb/symbols/

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "level3(ralt_switch)"

    name[Group1] = "Russian (Mnemonic, US)";

    key <TLDE> { [ Cyrillic_shcha,    Cyrillic_SHCHA,    grave,            asciitilde        ] }; // щ Щ ` ~
    key <AE01> { [ 1,                 exclam,            1,                exclam            ] }; // 1 ! 1 !
    key <AE02> { [ 2,                 at,                2,                at                ] }; // 2 @ 2 @
    key <AE03> { [ 3,                 numbersign,        3,                numbersign        ] }; // 3 # 3 #
    key <AE04> { [ 4,                 dollar,            4,                dollar            ] }; // 4 $ 4 $
    key <AE05> { [ 5,                 percent,           5,                percent           ] }; // 5 % 5 %
    key <AE06> { [ 6,                 asciicircum,       6,                asciicircum       ] }; // 6 ^ 6 ^
    key <AE07> { [ 7,                 ampersand,         7,                ampersand         ] }; // 7 & 7 &
    key <AE08> { [ 8,                 asterisk,          8,                asterisk          ] }; // 8 * 8 *
    key <AE09> { [ 9,                 parenleft,         9,                parenleft         ] }; // 9 ( 9 (
    key <AE10> { [ 0,                 parenright,        0,                parenright        ] }; // 0 ) 0 )
    key <AE11> { [ Cyrillic_softsign, Cyrillic_SOFTSIGN, minus,            underscore        ] }; // ь Ь - _
    key <AE12> { [ Cyrillic_hardsign, Cyrillic_HARDSIGN, equal,            plus              ] }; // ъ Ъ = +

    key <AD01> { [ Cyrillic_ya,       Cyrillic_YA,       Cyrillic_ya,      Cyrillic_YA       ] }; // я Я я Я
    key <AD02> { [ Cyrillic_sha,      Cyrillic_SHA,      Cyrillic_sha,     Cyrillic_SHA      ] }; // ш Ш ш Ш
    key <AD03> { [ Cyrillic_ie,       Cyrillic_IE,       Cyrillic_io,      Cyrillic_IO       ] }; // е Е ё Ё
    key <AD04> { [ Cyrillic_er,       Cyrillic_ER,       Cyrillic_er,      Cyrillic_ER       ] }; // р Р р Р
    key <AD05> { [ Cyrillic_te,       Cyrillic_TE,       Cyrillic_te,      Cyrillic_TE       ] }; // т Т т Т
    key <AD06> { [ Cyrillic_yeru,     Cyrillic_YERU,     Cyrillic_yeru,    Cyrillic_YERU     ] }; // ы Ы ы Ы
    key <AD07> { [ Cyrillic_u,        Cyrillic_U,        Cyrillic_u,       Cyrillic_U        ] }; // у У у У
    key <AD08> { [ Cyrillic_i,        Cyrillic_I,        Cyrillic_i,       Cyrillic_I        ] }; // и И и И
    key <AD09> { [ Cyrillic_o,        Cyrillic_O,        Cyrillic_o,       Cyrillic_O        ] }; // о О о О
    key <AD10> { [ Cyrillic_pe,       Cyrillic_PE,       Cyrillic_pe,      Cyrillic_PE       ] }; // п П п П
    key <AD11> { [ Cyrillic_yu,       Cyrillic_YU,       bracketleft,      braceleft         ] }; // ю Ю [ {
    key <AD12> { [ Cyrillic_zhe,      Cyrillic_ZHE,      bracketright,     braceright        ] }; // ж Ж ] }

    key <AC01> { [ Cyrillic_a,        Cyrillic_A,        Cyrillic_a,       Cyrillic_A        ] }; // а А а А
    key <AC02> { [ Cyrillic_es,       Cyrillic_ES,       Cyrillic_es,      Cyrillic_ES       ] }; // с С с С
    key <AC03> { [ Cyrillic_de,       Cyrillic_DE,       Cyrillic_de,      Cyrillic_DE       ] }; // д Д д Д
    key <AC04> { [ Cyrillic_ef,       Cyrillic_EF,       Cyrillic_ef,      Cyrillic_EF       ] }; // ф Ф ф Ф
    key <AC05> { [ Cyrillic_ghe,      Cyrillic_GHE,      Cyrillic_ghe,     Cyrillic_GHE      ] }; // г Г г Г
    key <AC06> { [ Cyrillic_che,      Cyrillic_CHE,      Cyrillic_che,     Cyrillic_CHE      ] }; // ч Ч ч Ч
    key <AC07> { [ Cyrillic_shorti,   Cyrillic_SHORTI,   Cyrillic_shorti,  Cyrillic_SHORTI   ] }; // й Й й Й
    key <AC08> { [ Cyrillic_ka,       Cyrillic_KA,       Cyrillic_ka,      Cyrillic_KA       ] }; // к К к К
    key <AC09> { [ Cyrillic_el,       Cyrillic_EL,       Cyrillic_el,      Cyrillic_EL       ] }; // л Л л Л
    key <AC10> { [ semicolon,         colon,             semicolon,        colon             ] }; // ; : ; :
    key <AC11> { [ apostrophe,        quotedbl,          apostrophe,       quotedbl          ] }; // ' " ' "

    key <BKSL> { [ Cyrillic_e,        Cyrillic_E,        backslash,        bar               ] }; // э Э \ |

    key <AB01> { [ Cyrillic_ze,       Cyrillic_ZE,       Cyrillic_ze,      Cyrillic_ZE       ] }; // з З з З
    key <AB02> { [ Cyrillic_ha,       Cyrillic_HA,       Cyrillic_ha,      Cyrillic_HA       ] }; // х Х х Х
    key <AB03> { [ Cyrillic_tse,      Cyrillic_TSE,      Cyrillic_tse,     Cyrillic_TSE      ] }; // ц Ц ц Ц
    key <AB04> { [ Cyrillic_ve,       Cyrillic_VE,       Cyrillic_ve,      Cyrillic_VE       ] }; // в В в В
    key <AB05> { [ Cyrillic_be,       Cyrillic_BE,       Cyrillic_be,      Cyrillic_BE       ] }; // б Б б Б
    key <AB06> { [ Cyrillic_en,       Cyrillic_EN,       Cyrillic_en,      Cyrillic_EN       ] }; // н Н н Н
    key <AB07> { [ Cyrillic_em,       Cyrillic_EM,       Cyrillic_em,      Cyrillic_EM       ] }; // м М м М
    key <AB08> { [ comma,             less,              comma,            less              ] }; // , < , <
    key <AB09> { [ period,            greater,           period,           greater           ] }; // . > . >
    key <AB10> { [ slash,             question,          slash,            question          ] }; // / ? / ?
};
